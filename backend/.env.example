# ---- Backend environment template ----
# Copy to backend/.env and fill in. NEVER commit the real backend/.env (it's gitignored).
# On Hostinger shared hosting, create these via hPanel -> Databases -> MySQL Databases,
# then put the matching values here (DB_HOST is "localhost" on Hostinger).

# Server
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string

# MySQL / MariaDB (Hostinger: hPanel -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_catalogue_user
DB_PASSWORD=your_db_password
DB_DATABASE=u123456789_catalogue_db

# CORS: REQUIRED for the split-domain setup (browser blocks cross-origin API
# calls otherwise). Comma-separated list of allowed frontend origins.
CORS_ORIGIN=backend_url
